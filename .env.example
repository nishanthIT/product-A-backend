# Copy into a local, untracked .env; use a deployment secret manager in production.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATABASE_URL=postgresql://app_user:REPLACE_ME@db.internal/paymi?sslmode=require
REDIS_URL=redis://:REPLACE_ME@redis.internal:6379
JWT_SECRET=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
SECURITY_AUDIT_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_BYTES
JWT_ISSUER=paymi-api
JWT_AUDIENCE=paymi-app
# Enable after old sessions have expired or deliberately invalidate them at rollout.
JWT_REQUIRE_ISSUER_AUDIENCE=true
PUBLIC_BASE_URL=https://api.example.com
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com
# Leave empty with no reverse proxy. Set exact proxy IPs/CIDRs, never hop counts.
TRUSTED_PROXY_CIDRS=
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_USER=noreply@example.com
MAIL_PASS=REPLACE_ME
# Retain the existing deployment's chat object-storage/mail/retention settings.
# Security policy thresholds live in Security Center, within server-side bounds.
